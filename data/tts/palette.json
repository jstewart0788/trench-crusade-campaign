{
  "$schema": "tc-tts-palette-v2",
  "name": "trench-lines",
  "cellIn": 4,
  "groundTopIn": 2.5,
  "coordinates": "Board inches, origin bottom-left as data/rules/scenarios.json. Board +x is world +x (E), board +y is world +z (N). footprintIn, heightIn and pivotOffsetIn (visual bounds centre minus pivot) are the mesh's visual bounds at rotY 0. restHeightIn is the pivot height above whatever the piece rests on, measured by letting it settle; topIn is the height of a piece's top above its own support, for pieces others stand on. A piece's support height (baseIn) is worked out by the generator from the stack under it.",
  "rotation": {
    "rotYSense": "cw",
    "verified": true,
    "note": "Verified live 2026-11-04: Landscape 1x2 at rotY 0 has its bounds centre 2in toward -z of the pivot; at rotY 90 it is 2in toward -x. So +rotY turns -z into -x, i.e. +z into +x: clockwise from above."
  },
  "revetment": {
    "pieceId": "log-fence",
    "insetIn": 1.35,
    "bottomAboveTrenchBaseIn": 0.2,
    "minFaceLengthIn": 3,
    "source": "Placed live 2026-11-04 against the bare -x wall of the plain straight: body centre 1.35 in from the cell centre, bottom 0.20 above the trench's base, rotY 0 for a -x wall (90 for +z, 180 for +x, 270 for -z); visually confirmed to read like the built-in Double Logs. The inner wall faces of the plain, ledge, logs, corner and T pieces measure within 0.06in of each other by collider raycast, so the same inset serves them all."
  },
  "sources": {
    "footprints": "data/tts/palette-measured-v2.json (live TTS 2026-11-04: collider and visual bounds, rest heights, stacked rest heights); earlier values in palette-measured.json and rest-heights-measured.json",
    "openings": "Measured and visually verified in the live game, top-down capture with a +z marker, 2026-11-04 (coordinator message to TC-021)",
    "verticality": "data/tts/VERTICALITY.md: how the reference maps stack pieces",
    "catalog": "data/tts/catalog.json supplies kind, urls, scale and colour at build time"
  },
