<!-- Xml UI. See documentation: https://api.tabletopsimulator.com/ui/introUI/ -->
<Defaults>
  <Button width="550" height="300" fontSize="40" onClick="" fontStyle="Bold"/>
  <Text fontSize="100" color="#000000" fontStyle="Bold"/>
</Defaults>

<Panel id="redirect" active="false" position="0 0 0" scale="0.6 0.6 0.6" offsetXY="0 0" color="#dbeaf9" width="1200" height="800" rectAlignment="MiddleCenter">
  <Text offsetXY="0 350" fontSize="80" color="#E74C3C" fontStyle="Bold">WARNING</Text>

  <Text id="coreRedirect" offsetXY="0 0" fontSize="40" color="#ECF0F1">
      PLEASE WAIT FOR LOADING
  </Text>

  <Button id="closeRedirectBtn" active="true" offsetXY="0 -400" color="#1A1A1A" textColor="#FFFFFF" width="500" height="100" fontSize="40" fontStyle="Bold" onClick="closeRedir" outline="#E74C3C" outlineSize="5" roundEdges="true">CLOSE</Button>
</Panel>

<Panel id="main" active="false" position="0 0 0" scale="0.5 0.5 0.5" offsetXY="0 0" color="#10141EEE" outline="#31415F" outlineSize="8" width="1600" height="1000" rectAlignment="MiddleCenter" visibility="Diamonds">
  <Button id="closeBtn" color="#1A1A2ACC" textColor="#FFFFFF" width="80" height="80" fontSize="42" fontStyle="Bold" roundEdges="true" onClick="closeMenu" outline="#5B6780" outlineSize="3" offsetXY="720 420">X</Button>
  <Text id="SplashPatch" text="Patch 1.3d" fontSize="72" color="#F3F6FA" fontStyle="Bold" offsetXY="0 370" alignment="MiddleCenter"/>
  <Text text="TRENCH CRUSADE TABLE" fontSize="42" color="#AFC1D8" fontStyle="Bold" offsetXY="0 300" alignment="MiddleCenter"/>

  <Panel id="SplashChangelog" width="1360" height="500" offsetXY="0 0" color="#182233CC" outline="#31415F99" outlineSize="3">
    <Text text="Patch Notes" fontSize="34" color="#F3F6FA" fontStyle="Bold" offsetXY="0 220" alignment="MiddleCenter"/>
    <VerticalScrollView id="SplashChangelogScroll" width="1300" height="400" offsetXY="0 -40" color="#00000000" scrollSensitivity="30" verticalScrollbarVisibility="AutoHide">
      <Text id="SplashChangelogText" text="* Forked from LCT v1.12.1 with the Warhammer 40k systems removed&#10;* See mod/STRIP-LOG.md and mod/TESTING.md" fontSize="26" color="#D8E1EA" width="1260" height="900" alignment="UpperLeft"/>
    </VerticalScrollView>
  </Panel>

  <Button id="redBtn" color="#B52020" textColor="#FFFFFF" width="460" height="150" fontSize="52" fontStyle="Bold" roundEdges="true" onClick="placeToRed" outline="#F06A6A" outlineSize="4" offsetXY="-540 -350">Red</Button>
  <Button id="greyBtn" color="#4A4A4A" textColor="#FFFFFF" width="300" height="150" fontSize="38" fontStyle="Bold" roundEdges="true" onClick="placeToSpectator" outline="#9C9C9C" outlineSize="4" offsetXY="0 -350">Spectator</Button>
  <Button id="blueBtn" color="#1A5FC8" textColor="#FFFFFF" width="460" height="150" fontSize="52" fontStyle="Bold" roundEdges="true" onClick="placeToBlue" outline="#6DA8FF" outlineSize="4" offsetXY="540 -350">Blue</Button>
</Panel>

<!-- Custom bubble size input overlay - one per player (opened by right-clicking Go on the Measure &amp; Mark panel or the "3. Custom Bubble" game key). Visibility is fixed so a player only ever sees their own. -->
<Panel id="bubbleOverlay_Red" visibility="Red" active="false" rectAlignment="MiddleCenter" scale="0.75 0.75 0.75" width="560" height="340" color="#10141EF2" outline="#31415F" outlineSize="4" allowDragging="true" restrictDraggingToParentBounds="false" returnToOriginalPositionWhenReleased="false">
  <VerticalLayout padding="40 40 30 30" spacing="20" childForceExpandHeight="false">
    <Text fontSize="38" fontStyle="Bold" color="#F3F6FA" alignment="MiddleCenter" preferredHeight="56">Custom Bubble Size</Text>
    <Text fontSize="22" color="#AFC1D8" alignment="MiddleCenter" preferredHeight="34">Values:1-60. Blank or 0 clears.</Text>
    <InputField id="bubbleInputField_Red" placeholder="" characterLimit="2" contentType="IntegerNumber" fontSize="40" alignment="MiddleCenter" color="#FFFFFF" textColor="#10141E" onValueChanged="cacheBubbleInput" onEndEdit="submitBubbleInput" preferredHeight="80"/>
    <Button fontSize="30" fontStyle="Bold" textColor="#FFFFFF" color="#1A5FC8" onClick="submitBubbleInput" preferredHeight="70">OK</Button>
  </VerticalLayout>
  <Button text="X" fontSize="24" textColor="#FFFFFF" color="#B52020" width="44" height="44" roundEdges="true" outline="#2a2a4aCC" outlineSize="3" offsetXY="242 140" onClick="closeBubbleOverlay" tooltip="Close"/>
</Panel>
<Panel id="bubbleOverlay_Blue" visibility="Blue" active="false" rectAlignment="MiddleCenter" scale="0.75 0.75 0.75" width="560" height="340" color="#10141EF2" outline="#31415F" outlineSize="4" allowDragging="true" restrictDraggingToParentBounds="false" returnToOriginalPositionWhenReleased="false">
  <VerticalLayout padding="40 40 30 30" spacing="20" childForceExpandHeight="false">
    <Text fontSize="38" fontStyle="Bold" color="#F3F6FA" alignment="MiddleCenter" preferredHeight="56">Custom Bubble Size</Text>
    <Text fontSize="22" color="#AFC1D8" alignment="MiddleCenter" preferredHeight="34">Values:1-60. Blank or 0 clears.</Text>
    <InputField id="bubbleInputField_Blue" placeholder="" characterLimit="2" contentType="IntegerNumber" fontSize="40" alignment="MiddleCenter" color="#FFFFFF" textColor="#10141E" onValueChanged="cacheBubbleInput" onEndEdit="submitBubbleInput" preferredHeight="80"/>
    <Button fontSize="30" fontStyle="Bold" textColor="#FFFFFF" color="#1A5FC8" onClick="submitBubbleInput" preferredHeight="70">OK</Button>
  </VerticalLayout>
  <Button text="X" fontSize="24" textColor="#FFFFFF" color="#B52020" width="44" height="44" roundEdges="true" outline="#2a2a4aCC" outlineSize="3" offsetXY="242 140" onClick="closeBubbleOverlay" tooltip="Close"/>
</Panel>

<!-- DEBUG TOOLS panel (screen-space). Hidden by default; Global.onLoad activates it
     only on DEBUG (test) builds, so release builds carry it but never show it.
     Every onClick/onValueChanged handler lives in Global (function definitions in
     global.ttslua). Replaces the old spawned "LCT Debug Panel" tile. -->
<Panel id="DebugTools" active="false" rectAlignment="UpperLeft" offsetXY="20 -20" scale="0.8 0.8 0.8" width="460" height="740" color="#10141EF2" outline="#31415F" outlineSize="4" allowDragging="true" restrictDraggingToParentBounds="false" returnToOriginalPositionWhenReleased="false">
  <VerticalLayout padding="18 18 16 16" spacing="10" childForceExpandHeight="false">
    <Text fontSize="30" fontStyle="Bold" color="#F3F6FA" alignment="MiddleCenter" preferredHeight="42">DEBUG TOOLS</Text>
    <VerticalLayout id="DebugToolsBody" spacing="10" childForceExpandHeight="false">
    <Panel color="#FFFFFF40" preferredHeight="2" flexibleHeight="0"/>

    <Text fontSize="20" fontStyle="Bold" color="#AFC1D8" alignment="MiddleLeft" preferredHeight="26">Diagnostics</Text>
    <HorizontalLayout spacing="10" preferredHeight="78" flexibleHeight="0" childForceExpandWidth="true">
      <Button onClick="debugDumpSelectedGuids" color="#26331F" textColor="#66FF66" fontSize="22" tooltip="Select objects first, then click: writes their GUIDs into a tile's description to copy/paste">Dump selected&#10;GUIDs</Button>
    </HorizontalLayout>

    <Panel color="#FFFFFF40" preferredHeight="2" flexibleHeight="0"/>
    <Text fontSize="20" fontStyle="Bold" color="#AFC1D8" alignment="MiddleLeft" preferredHeight="26">Custom table mat URL</Text>
    <InputField id="debugMatUrlField" placeholder="paste mat image URL" fontSize="22" color="#FFFFFF" textColor="#10141E" onValueChanged="cacheDebugMatUrl" onEndEdit="onDebugMatApply" preferredHeight="64"/>
    <Button onClick="onDebugMatApply" color="#C28A2B" textColor="#10141E" fontSize="26" fontStyle="Bold" preferredHeight="62">Set mat from URL</Button>
    </VerticalLayout>
  </VerticalLayout>
  <Button id="DebugToolsMinBtn" text="—" fontSize="24" textColor="#FFFFFF" color="#B52020" width="44" height="44" roundEdges="true" outline="#2a2a4aCC" outlineSize="3" rectAlignment="UpperRight" offsetXY="-26 -26" onClick="minimizeDebugTools" tooltip="Minimize"/>
</Panel>

